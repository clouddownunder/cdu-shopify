<ul class="social-link {{ class }}">
  {%- if settings.social_facebook_link != blank -%}
    <li>
      <a href="{{ settings.social_facebook_link }}" >
          {{- 'icon-facebook-black.svg' | inline_asset_content -}}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
    <li>
      <a href="{{ settings.social_instagram_link }}" >
          {{- 'icon-instagram-black.svg' | inline_asset_content -}}
      </a>
    </li>
  {%- endif -%}
    {%- if settings.social_twitter_link != blank -%}
    <li>
      <a href="{{ settings.social_twitter_link }}" >
          {{- 'icon-twitter-black.svg' | inline_asset_content -}}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_linkdin_link != blank -%}
    <li>
      <a href="{{ settings.social_linkdin_link }}" >
          {{- 'icon-linkdln-black.svg' | inline_asset_content -}}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    <li>
      <a href="{{ settings.social_youtube_link }}" >
          {{- 'icon-youtube-black.svg' | inline_asset_content -}}
      </a>
    </li>
  {%- endif -%}
</ul>
