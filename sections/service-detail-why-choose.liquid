{% if section.settings.heading != blank or section.settings.subtitle != blank or section.settings.liquid_code != blank %}
<section class="sf-why-section sec-padding">
  <div class="container">
    <div class="section_heading text-start">
        <span class="sec_subtitle mb-0 theme_black">
            <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#0B0C0E"></path>
            </svg>
            {% if section.settings.subtitle != blank %}
            {{ section.settings.subtitle }}
            {% else %}
              Why CDU
            {% endif %}
        </span>
        <h2 class="sec_typo mb-0 mt-1">{{ section.settings.heading }}</h2>
        <p class="mb-0 p_font_color font-300 mt-3">{{ section.settings.description }}</p>
    </div>
    <div id="sf-why-source-{{ section.id }}" style="display:none;">{{ section.settings.liquid_code }}</div>
    <div class="sf-why-row" id="sf-why-row-{{ section.id }}"></div>
  </div>
</section>

<script>
(function () {
  var source = document.getElementById('sf-why-source-{{ section.id }}');
  var target = document.getElementById('sf-why-row-{{ section.id }}');

  if (source && target) {
    target.innerHTML = source.textContent;

    // Find age/experience value and calculate automatically
    target.querySelectorAll('h4').forEach(function (element) {
      if (element.textContent.trim() === '14+') {
        var experienceDate = new Date('2012-03-22T00:00:00');
        var today = new Date();

        var age = today.getFullYear() - experienceDate.getFullYear();

        var monthDiff = today.getMonth() - experienceDate.getMonth();

        if (
          monthDiff < 0 ||
          (monthDiff === 0 && today.getDate() < experienceDate.getDate())
        ) {
          age--;
        }

        element.classList.add('age-display');
        element.setAttribute('data-experiencedate', '2012-03-22');
        element.textContent = age + '+';
      }
    });
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Service Detail Why Choose",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Why CDU for Salesforce"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built by consultants who run Salesforce orgs, not just configure them."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "The complete Salesforce development practice is led by certified consultants with rich experience of hands on delivery across Astralian mid-market businesses and enterprise level organizations."
    },
    {
      "type": "richtext",
      "id": "liquid_code",
      "label": "Liquid Code"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Service Detail Why Choose"
    }
  ]
}
{% endschema %}