<section class="banner-sec banner-height-auto p-0 mt-2">
    <div class="banner-wrap  rounded-0">
        <div class="container">
            <div class="banner-links-main">
                <ul class="breadcrumb">
                    <li class="banner-links"><a href="{{ section.settings.home_link | default: '/' }}">{{ section.settings.home_text | default: 'Home' }}</a></li>
                    <li class="banner-links"><span>/</span></li>
                    <li class="banner-links active"><span>{{ section.settings.current_page | default: 'Sitemap' }}</span></li>
                </ul>
            </div>
            <div class="row">
                <div class="col-xxl-7 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="banner-text-wrap mb-2">
                        <div class="banner-text">
                            <div class="banner-heading-wrap">
                                <h1 class="banner-heading text-uppercase mb-4 mb-lg-0">{{ section.settings.heading | default: 'CDU Sitemap' }}</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="sitemap-content-sec">
  <div class="container">
    <div class="sitemap-content">

      <div class="sitemap-block-main">
        {% for block in section.blocks %}
          {% render block %}

          {% unless forloop.last %}
            <hr class="seprate">
          {% endunless %}
        {% endfor %}
      </div>

    </div>
  </div>
</section>


{% schema %}
{
  "name": "Sitemap Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "url",
      "id": "home_link",
      "label": "Home Link"
    },
    {
      "type": "text",
      "id": "home_text",
      "label": "Home Text",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "current_page",
      "label": "Current Page",
      "default": "Sitemap"
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CDU Sitemap"
    }
  ],
  "blocks": [
    {
      "type": "sitemap-header"
    }
  ],
  "presets": [
    {
      "name": "Sitemap Page",
      "settings": {
        "home_link": "/",
        "home_text": "Home",
        "current_page": "Sitemap",
        "heading": "CDU Sitemap"
      }
    }
  ]
}
{% endschema %}
