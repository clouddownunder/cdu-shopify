<section class="industry-serve">
  <div class="container">
    <div class="section_heading text-center">
      <span class="sec_subtitle mb-0 text-white">
        <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#fff" />
        </svg> 
        {{ section.settings.section_subtitle }}
      </span>
      <h2 class="sec_typo mb-0 mt-1 text-white">{{ section.settings.section_title }}</h2>
      <p class="mb-0 p_font_color mt-lg-4 mt-3">{{ section.settings.section_description }}</p>
    </div>
  </div>

  <div class="industry-sl-main">
    <div class="main-slick-slider">
      <div class="indus-border-overlay">
        <div class="slider-nav-wrapper">
          {% for block in section.blocks %}
          <div class="industry-item"><span class="industry-name">{{ block.settings.industry_name }}</span></div>
          {% endfor %}
        </div>
      </div>

      <div class="container c1440">
        <div class="slider-for">
          {% for block in section.blocks %}
          <div class="industry-slide">
            <div class="row">
              <div class="col-xxl-6 col-xl-4 col-lg-5">
                <div class="case-image-wrap">
                  <img src="{{ block.settings.industry_image | image_url : width :"1200" }}" alt="image">
                </div>
              </div>
              <div class="col-xxl-6 col-xl-8 col-lg-7">
                <div class="cs-content-wrap">
                  <div class="cs-content-flex">
                    <h4 class="sec_typo indus-slide-title text-white">{{ block.settings.industry_name }}</h4>
                    <p class="p_font_color indus-slide-disc">{{ block.settings.industry_description }}</p>
                    <ul class="industry-list">
