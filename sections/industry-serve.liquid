{% schema %}
{
  "name": "Industry Serve",
  "settings": [
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Industries We Serve"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Solutions Built Around Your Industry"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "We partner with organisations across Australia to solve complex business challenges with cloud, AI, enterprise software, and digital transformation—tailored to the unique needs of every industry."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get in Touch"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "industry",
      "name": "Industry",
      "settings": [
        {
          "type": "text",
          "id": "industry_name",
          "label": "Industry Name",
          "default": "Healthcare & Life Sciences"
        },
        {
          "type": "image_picker",
          "id": "industry_image",
          "label": "Industry Image"
        },
        {
          "type": "textarea",
          "id": "industry_description",
          "label": "Industry Description",
          "default": "Build secure, intelligent healthcare platforms that improve patient experiences, streamline operations, and meet Australia's strict privacy and compliance requirements."
        },
        {
          "type": "text",
          "id": "service_1",
          "label": "Service 1",
          "default": "Patient Engagement Platforms"
        },
        {
          "type": "text",
          "id": "service_2",
          "label": "Service 2",
          "default": "Appointment & Booking Systems"
        },
        {
          "type": "text",
          "id": "service_3",
          "label": "Service 3",
          "default": "Secure Data Management"
        },
        {
          "type": "text",
          "id": "service_4",
          "label": "Service 4",
          "default": "AI-Powered Healthcare Automation"
        },
        {
          "type": "textarea",
          "id": "stat1_value",
          "label": "Stat 1 Value",
          "default": "25%"
        },
        {
          "type": "text",
          "id": "stat1_label",
          "label": "Stat 1 Label",
          "default": "Reduction in Administrative Work"
        },
        {
          "type": "textarea",
          "id": "stat2_value",
          "label": "Stat 2 Value",
          "default": "150K+"
        },
        {
          "type": "text",
          "id": "stat2_label",
          "label": "Stat 2 Label",
          "default": "Patient Records Managed Securely"
        },
        {
          "type": "textarea",
          "id": "stat3_value",
          "label": "Stat 3 Value",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "stat3_label",
          "label": "Stat 3 Label",
          "default": "Platform Availability"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Industry Serve"
    }
  ]
}
