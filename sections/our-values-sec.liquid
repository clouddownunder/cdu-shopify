        },
        {
          "type": "image_picker",
          "id": "stat_image",
          "label": "Stat Image"
        }
      ]
    },
    {
      "type": "achievement_logo",
      "name": "Achievement Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "achievement_logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "achievement_name",
          "label": "Achievement Name",
          "default": "Rating Logo"
        }
      ]
    }
  ],
  "presets": [
