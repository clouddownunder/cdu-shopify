      "content": "Left column — email"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@clouddownunder.com.au"
    },

    {
      "type": "header",
      "content": "Right column — form"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form Title",
      "default": "Empower Your Growth: Partner with Us Today!"
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First Name Placeholder",
      "default": "First Name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last Name Placeholder",
      "default": "Last Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone Placeholder",
      "default": "Phone"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message Placeholder",
      "default": "Discuss about your project…"
    },
    {
      "type": "textarea",
      "id": "privacy_text",
      "label": "Privacy Text",
      "default": "We'll add your info to our CRM for contacting you regarding your request. For more info please consult our privacy policy."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
