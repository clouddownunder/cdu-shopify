    },

    {
      "type": "header",
      "content": "On-page thank-you message"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Title",
      "default": "Thanks, we got it!"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success Message",
      "default": "Your message has been sent — a member of our team will be in touch soon."
    }
  ],

  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "stat",
      "name": "Stat Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (optional, falls back to default icon)"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "200+ clients"
        }
      ]
    },

    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I get in touch?"
