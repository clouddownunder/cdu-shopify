{%  if section.settings.image != blank or section.settings.subtitle != blank %}
<section class="sr-detail-platforms sec-padding overflow-hidden">
    <div class="container">
        <div class="s-details-wrap">
            <img src="{{ section.settings.image | image_url }}" alt="image" loading="lazy">
        </div>
        <div class="sr-platforms-wrap">
            <div class="row">
                <div class="col-lg-8">
                    <div class="sr-platform-head">
                        <div class="section_heading">
                            <span class="sec_subtitle mb-0 theme_black">
                                <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#000"></path>
                                </svg>
                                {{ section.settings.subtitle }}
                            </span>
                            <h2 class="sec_typo mb-0 mt-1">
                                {{ section.settings.heading }}
                            </h2>
                        </div> 
                        <div class="sr-platform-disc">
                            {{ section.settings.description | replace: '<p>', '<p class="light_green font-300 sf-disc">' }}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="sr-benifits-box">
                        <h4 class="mb-2">{{ section.settings.benefits_title }}</h4>
                        <p class="light_green font-300 mb-0">{{ section.settings.benefits_description }}</p>
                        
                        <div class="sr-benifits-items-wrap">
                            {% assign tags = section.settings.benefits_list | split: ',' %}
                            {% for tag in tags %}
                            <div class="sr-benifits-item mb-2">
                                <img src="https://cdn.shopify.com/s/files/1/0786/1472/4748/files/right-icon.svg?v=1786440375" alt="image">
                                <p class="theme_green mb-0 font-md">{{ tag | strip }}</p>
                            </div>
                            {% endfor %}
                        </div>
                        <div class="btn-wp">
                            <a href="{{  section.settings.benefits_button_url }}" class="btn btn-with-arrow">{{ section.settings.benefits_button_text }}</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sr-platforms-grid">
                {% for block in section.blocks %}
                <div class="sr-platform-item">
                    <span class="sr-platform-icon-main">
                        <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#000"></path>
                        </svg>
                    </span>
                    <div class="sr-platform-text">
                      <h5 class="mb-2">{{  block.settings.list_label }}</h5>
                      <p class="light_green font-300">{{ block.settings.list_description }}</p>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Service Detail Platform",
  "settings": [
    {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default":"Platforms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clouds & platforms CDU is in demand for"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default":"We analyze and evaluate and then scope the right combination of clouds that best fit to the size of your business as well as the industry you are in – Not-a-one-Size Fits- all package."
    },
    {
      "type": "header",
      "content":"Benefit Box"
    },
    {
      "type": "text",
      "id": "benefits_title",
      "label": "Benefits Title",
      "default": "Benifit’s the Services"
    },
    {
      "type": "text",
      "id": "benefits_description",
      "label": "Benefits Description",
      "default":"Leadership skill before media innovation customer directed alignments"
    },
    {
      "type": "text",
      "id": "benefits_list",
      "label": "Benefits List",
      "default":"Professional Team Member , Any Problem Solving , Implement Business"
    },
    {
      "type": "text",
      "id": "benefits_button_text",
      "label": "Benefits Button Text",
      "default":"Start Your Project"
    },
    {
      "type": "url",
      "id": "benefits_button_url",
      "label": "Benefits Button Url",
    }
  ],
  "blocks": [
    {
        "type": "list_item",
        "name": "List Item",
        "settings": [
            {
                "type": "text",
                "id": "list_label",
                "label": "List Label",
                "default": "List Label"
            },
            {
                "type": "text",
                "id": "list_description",
                "label": "List Description",
                "default": "List Description"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Service Detail Platform"
    }
  ]
}
{% endschema %}