                    </div>
                </div> {% endcomment %}
            </div>
            <div class="salesforce-middle">
                <div class="section_heading">
                    <span class="sec_subtitle mb-0 theme_black">
                        <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#000"></path>
                        </svg>
                        {{ section.settings.subtitle }}
                    </span>
                    <h2 class="sec_typo mb-0 mt-1">
                        {{ section.settings.heading }}
                    </h2>

                    {% assign description = section.settings.description %}
                    {% if description contains '<p>' %}
                        {{ description | replace: '<p>', '<p class="mb-0 p_font_color font-300 mt-3 sf-disc">' }}
                    {% else %}
                    <p class="mb-0 p_font_color font-300 mt-3 sf-disc">
                        {{ description }}
                    </p>
                    {% endif %}
                </div>
            </div>
            <div class="salesforce-right">
                <div class="sf-hero-tags tech-stack">
                    {% assign tags = section.settings.right_button_text | split: ',' %}
                    {% for tag in tags %}
                        <span>
                        {{ tag | strip }}
                        </span>
                    {% endfor %}
                </div>
                <div class="sf-right-img">
                    <img src="{{ section.settings.right_image | image_url : width:"1200" }}" alt="image">
                </div>
            </div>
        </div>

        <div class="sf-capability-grid">
            <div class="row gx-xl-5 gx-3">
                {% for block in section.blocks %}
                <div class="col-md-6">
                    <div class="sf-cap-item">
                        <img src="{{ block.settings.list_image | img_url }}" alt="image" class="sf-icon">
                        <div class="sf-cap-content">
                            <h5 class="h6 mb-1">{{  block.settings.list_label }}</h5>
                            <p class="p_font_color font-300">{{ block.settings.list_description }}</p>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Service Sales Force",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "What's included"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Eight Salesforce capabilities, one accountable team."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default":"Feel free to engage us even for single capability or a full-stack Salesforce transformation. Yet each capability stated below can run standalone project or as a part of a large program."
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "right_button_text",
      "label": "Right Button Text",
      "default":"Sales Cloud , Service Cloud , Agentforce"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "image_picker",
      "id": "rating_image",
      "label": "Rating Image"
    },
    {
      "type": "text",
      "id": "rating_title",
      "label": "Rating Title",
      "default": "A+ rating"
    },
    {
      "type": "text",
      "id": "rating_subtitle",
      "label": "Rating Subtitle",
      "default": "Average 5.00 rating"
    }
  ],
  "blocks": [
    {
        "type": "list_item",
        "name": "List Item",
        "settings": [
            {
                "type": "image_picker",
                "id": "list_image",
                "label": "List Image"
            },
            {
                "type": "text",
                "id": "list_label",
                "label": "List Label",
                "default": "List Label"
            },
            {
                "type": "text",
                "id": "list_description",
                "label": "List Description",
                "default": "List Description"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Service Sales Force"
    }
  ]
}
{% endschema %}