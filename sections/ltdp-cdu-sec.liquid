<section class="ltdp-cdu-sec">
    <div class="container">
        <div class="ltdp-cdu-top">
            <div class="section_heading text-center">
                <span class="sec_subtitle text-black text-center">
                            <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z"
                                    fill="#000" />
                            </svg> 
                            {{ section.settings.subtitle }}
                        </span>
                <h2 class="sec_typo">{{ section.settings.section_title }}</h2>
                <p class="mb-0 p_font_color mt-lg-3 mt-3">{{ section.settings.section_description }}</p>
            </div>
        </div>

        <div class="video-ltdp-cdu-wrap">
            <div class="ltdp-cdu-sec-video">
                <div class="ltdp-posters">
                    <div class="ltdp-cdu-video-main text-center">
                        <img src="{{ section.settings.video_image | image_url : width :"1200" }}" alt="#" class="">
                        {% assign video_source = section.settings.video_link.sources | where: 'format', 'mp4' | first %}
                        <a href="{{ video_source.url }}" data-fancybox class="play-link"><img src="https://cdn.shopify.com/s/files/1/0786/1472/4748/files/play-icon.svg?v=1786337032" alt="#"></a>
                    </div>

                    <a href="{{ section.settings.discuss_link }}" alt="#" class="ltdp-cdu-discuss-bubble">
                        <div class="ltdp-cdu-discuss-avatar">
                            <img src="{{ section.settings.avatar_image | image_url : width :"1200" }}" alt="Team lead">
                            <span class="phn-icon">
                                <img src="https://cdn.shopify.com/s/files/1/0786/1472/4748/files/plus-with-call.svg?v=1786336810" alt="Phone">
                            </span>
                        </div>
                        <div class="ltdp-cdu-discuss-text">
                            <h4>{{ section.settings.discuss_title }}</h4>
                            <p>{{ section.settings.discuss_subtitle }}</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="ltdp-cdu-reviews-row">
            {% for block in section.blocks %}
            <div class="ltdp-cdu-review-box">
                <div class="ltdp-cdu-review-logo">
                    <img src="{{ block.settings.platform_logo | image_url : width :"1200" }}" alt="{{ block.settings.platform_name }}">
                </div>
                <div class="ltdp-cdu-review-info">
                    <div class="ltdp-cdu-review-stars">
                        {% assign star_count = block.settings.star_count | default: 5 %}
                        {% for i in (1..star_count) %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-star-fill" viewBox="0 0 16 16">
                            <path d="M3.612 15.443c-.386.198-.824-.149-.746-.592l.83-4.73L.173 6.765c-.329-.314-.158-.888.283-.95l4.898-.696L7.538.792c.197-.39.73-.39.927 0l2.184 4.327 4.898.696c.441.062.612.636.282.95l-3.522 3.356.83 4.73c.078.443-.36.79-.746.592L8 13.187l-4.389 2.256z"/>
                        </svg>
                        {% endfor %}
                    </div>
                    <p><strong>{{ block.settings.rating }}</strong> {{ block.settings.review_count }}</p>
                </div>
            </div>
            {% endfor %}
        </div>

        <div class="long-tearm-main-bottom">
            <div class="long-tearm-mb-top text-center">
                <p class="mb-0 font20">{{ section.settings.bottom_text }}</p>
            </div>
            <div class="long-tearm-mb-bottom align-self-center text-center">
                <div class="cta-main">
                    <a href="{{ section.settings.button_link }}" class="btn btn-with-arrow">{{ section.settings.button_text }}</a>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Long-term Digital Partner",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your Long-term Digital Partner"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Helping Businesses Turn Bold Ideas Into Digital Success"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "At Cloud Downunder, we partner with startups, growing businesses, and enterprises to design, develop, and scale digital products that solve real business challenges."
    },
    {
      "type": "image_picker",
      "id": "video_image",
      "label": "Video Poster Image"
    },
    {
      "type": "video",
      "id": "video_link",
      "label": "Video Link"
    },
    {
      "type": "image_picker",
      "id": "avatar_image",
      "label": "Avatar Image"
    },
    {
      "type": "text",
      "id": "discuss_title",
      "label": "Discuss Title",
      "default": "Discuss your projects"
    },
    {
      "type": "text",
      "id": "discuss_subtitle",
      "label": "Discuss Subtitle",
      "default": "Speak with the team lead"
    },
    {
      "type": "url",
      "id": "discuss_link",
      "label": "Discuss Link"
    },
    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Bottom Text",
      "default": "We believe great digital products are built through collaboration, transparency, and a deep understanding of your business."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "See Our Work"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Platform",
      "settings": [
        {
          "type": "text",
          "id": "platform_name",
          "label": "Platform Name",
          "default": "Clutch"
        },
        {
          "type": "image_picker",
          "id": "platform_logo",
          "label": "Platform Logo"
        },
        {
          "type": "range",
          "id": "star_count",
          "label": "Star Count",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "default": "4.9/5"
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review Count",
          "default": "Based on 250 reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Long-term Digital Partner"
    }
  ]
}
{% endschema %}