{% if section.settings.subtitle != blank or section.settings.heading != blank or section.settings.heading_bold != blank  %}
<section class="banner-sec services-banner service-detail map-bg">
    <div class="banner-wrap">
        <div class="container-fluid">
            <div class="row justify-content-center align-items-center">
                <div class="col-lg-10 col-12">
                    <div class="banner-text-wrap align-items-center text-center">
                        <div class="banner-text">
                            <div class="banner-heading-wrap">
                                <h1 class="font-rg banner-heading">{{ section.settings.heading }}</h1>
                            </div>
                            <p class="font18 mb-2">{{ section.settings.subheading }}</p>
                            <p class="font18">{{ section.settings.description }}
                            </p>
                        </div>
                        <div class="banner-btn-main d-flex flex-wrap justify-content-center">
                            <div class="btn-wp">
                                <a href="{{ section.settings.button_1_link }}" class="btn btn-with-arrow me-3 mb-3">{{ section.settings.button_1_text }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
  <section class="banner-sec services-banner service-detail map-bg">
    <div class="banner-wrap">
        <div class="container-fluid">
            <div class="row justify-content-center align-items-center">
                <div class="col-lg-10 col-12">
                    <div class="banner-text-wrap align-items-center text-center">
                        <div class="banner-text">
                            <div class="banner-heading-wrap">
                                <h1 class="font-rg banner-heading">{{ section.settings.title }}
                                </h1>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="banner-speak-team d-flex align-items-center">
                                <div class="flex-0-auto">
                                    <img src="{{ section.settings.team_image | img_url }}" alt="#">
                                </div>
                                <div class="w-100 ps-2 pe-3">
                                    <span class="d-inline-block w-100  font-md">{{ section.settings.team_title }}</span>
                                    <p class=" mb-0 grey_text">{{ section.settings.team_subtitle }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{%  endif %}
{% schema %}
{
  "name": "Service Detail Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Salesforce Solutions Services that turn your CRM into"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "a growth engine not another system to babysit."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button 1 Text",
      "default": "Get a free Salesforce scoping cal"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 Link"
    }
  ],

  "presets": [
    {
      "name": "Service Detail Banner"
    }
  ]
}
{% endschema %}