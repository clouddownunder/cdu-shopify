{% if section.settings.subtitle != blank or section.settings.heading != blank  %}
<section class="outcomes-sec">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="outcomes-wrap">
                    <div class="outcomes-flex">
                        <div class="outcomes-top">
                            <span class="sec_subtitle text-black mb-0">
                                    <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none"
                                        xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z"
                                            fill="#0B0C0E" />
                                    </svg>
                                    {{ section.settings.subtitle }}
                                </span>
                            <h2 class="sec_typo outcomes-title">
                                {{ section.settings.heading }}
                            </h2>
                            <p class="outcomes-disc mb-0">
                                {{ section.settings.description }}
                            </p>
                        </div>
                        <div class="d-grid stats position-relative">
                            <div class="stats-box">
                                <div class="stats-detail">
                                    <p class="stats-title mb-2">{{ section.settings.box_1_subtitle }}</p>
                                    <h3 class="stats-bold">{{ section.settings.box_1_title }}</h3>
                                    <span class="stats-text">{{ section.settings.box_1_description }}</span></div>
                                <div class="graph-imgs"><img class="graphimg" src="{{ section.settings.box_1_image | img_url }}" alt=""></div>
                            </div>
                            <div class="stats-box">
                                <div class="stats-detail">
                                    <p class="stats-title mb-2">{{ section.settings.box_2_subtitle }}</p>
                                    <h3 class="stats-bold">{{ section.settings.box_2_title }}</h3>
                                    <span class="stats-text">{{ section.settings.box_2_description }}</span></div>
                                <div class="graph-imgs"><img class="graphimg" src="{{ section.settings.box_2_image | img_url }}" alt=""></div>
                            </div>
                            <div class="stats-box">
                                <div class="stats-detail">
                                    <p class="stats-title mb-2">{{ section.settings.box_3_subtitle }}</p>
                                    <h3 class="stats-bold">{{ section.settings.box_3_title }}</h3>
                                    <span class="stats-text">{{ section.settings.box_3_description }}</span></div>
                                <div class="graph-imgs"><img class="graphimg" src="{{ section.settings.box_3_image | img_url }}" alt=""></div>
                            </div>
                        </div>
                    </div>
                    <div class="btn-wp">
                        <a href="{{ section.settings.button_url }}" class="btn btn-with-arrow me-3 mb-0">{{ section.settings.button_text }}</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="case-image-wrap">
                    <img src="{{ section.settings.image | image_url: width:"1200" }}" alt="image">
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}
{% schema %}
