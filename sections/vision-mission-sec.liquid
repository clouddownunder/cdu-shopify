<section class="vision-mission-sec theme-bg-color">
    <div class="container">
        <div class="vision-mission-top">
            <div class="section_heading">
                <span class="sec_subtitle mb-0 theme_black">
                        <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#000"></path>
                    </svg>
                    {{ section.settings.subtitle | default: 'Our Values' }}</span>
                <h2 class="sec_typo mb-0 mt-1">{{ section.settings.section_title | default: 'What Shapes CDU Identity' }}</h2>
            </div>
        </div>
        <div class="vision-mission-main">
            <div class="row">
                {% for block in section.blocks %}
                <div class="{% if forloop.index <= 2 %}col-lg-6 col-md-12 col-sm-12 col-12{% else %}col-lg-12 col-md-12 col-sm-12 col-12{% endif %}" {{ block.shopify_attributes }}>
                    <div class="vision-mission-box">
                        <div class="vm-icon">
                            <img src="{{ block.settings.icon_image | image_url: width: "1200" }}" alt="{{ block.settings.icon_alt }}">
                        </div>
                        <div class="card-text-main journey-text">
                            <h3>{{ block.settings.card_title }}</h3>
                            <p>{{ block.settings.card_description }}</p>
                            {% if block.settings.show_values_list %}
                            <ul class="card-bullets">
                                {% for i in (1..10) %}
                                {% assign value_text = 'value_' | append: i %}
                                {% if block.settings[value_text] != blank %}
                                <li>{{ block.settings[value_text] }}</li>
                                {% endif %}
                                {% endfor %}
                            </ul>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

        </div>
    </div>
</section>

{% schema %}
{
  "name": "Vision Mission Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Our Values"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "What Shapes CDU Identity"
    }
  ],
  "blocks": [
    {
      "type": "vision_mission_card",
      "name": "Vision/Mission Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "icon_alt",
          "label": "Icon Alt Text",
          "default": "Icon"
        },
        {
          "type": "text",
          "id": "card_title",
          "label": "Card Title",
          "default": "Our Vision"
        },
        {
          "type": "textarea",
          "id": "card_description",
          "label": "Card Description",
          "default": "We at Cloud Downunder (CDU), are keen to lead the pack in the tech world, shaping tomorrow digital terrain across Australia and beyond. We envision a future where we craft innovative and sustainable solutions with seamless deployment that stir the pot in the digital economy."
        },
        {
          "type": "checkbox",
          "id": "show_values_list",
          "label": "Show Values List",
          "default": false
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Value 1"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Value 2"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Value 3"
        },
        {
          "type": "text",
          "id": "value_4",
          "label": "Value 4"
        },
        {
          "type": "text",
          "id": "value_5",
          "label": "Value 5"
        },
        {
          "type": "text",
          "id": "value_6",
          "label": "Value 6"
        },
        {
          "type": "text",
          "id": "value_7",
          "label": "Value 7"
        },
        {
          "type": "text",
          "id": "value_8",
          "label": "Value 8"
        },
        {
          "type": "text",
          "id": "value_9",
          "label": "Value 9"
        },
        {
          "type": "text",
          "id": "value_10",
          "label": "Value 10"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vision Mission Section",
      "settings": {
        "subtitle": "Our Values",
        "section_title": "What Shapes CDU Identity"
      },
      "blocks": [
        {
          "type": "vision_mission_card",
          "settings": {
            "icon_alt": "Vision Icon",
            "card_title": "Our Vision",
            "card_description": "We at Cloud Downunder (CDU), are keen to lead the pack in the tech world, shaping tomorrow digital terrain across Australia and beyond. We envision a future where we craft innovative and sustainable solutions with seamless deployment that stir the pot in the digital economy.",
            "show_values_list": false
          }
        },
        {
          "type": "vision_mission_card",
          "settings": {
            "icon_alt": "Mission Icon",
            "card_title": "Our Mission",
            "card_description": "Our mission is to bolster our mates—our clients—by delivering top-notch digital solutions that crank up their efficiency and edge over the competition. We are all about pulling together the brightest local talent and the latest tech to whip up tailored apps, offer maintenance and support, that really knock your socks off.",
            "show_values_list": false
          }
        },
        {
          "type": "vision_mission_card",
          "settings": {
            "icon_alt": "Values Icon",
            "card_title": "Our Values",
            "card_description": "In CDUs DNA, you will find a blend of Aussie can-do and tech smarts, all aimed at delivering not just solution-oriented services but effective catalysts that lead and redefine the industry. Our success is backed by our value system that keeps us united with zeal and enthusiasm.",
            "show_values_list": true,
            "value_1": "Innovation",
            "value_2": "Integrity",
            "value_3": "Customer-First Approach",
            "value_4": "Excellence",
            "value_5": "Collaboration",
            "value_6": "Adaptability",
            "value_7": "Sustainability",
            "value_8": "Attention to Detail"
          }
        }
      ]
    }
  ]
}
{% endschema %}
