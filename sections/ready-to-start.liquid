<section class="rts-cdu-sec">
  <div class="container">
    <div class="rts-cdu-main">
      <div class="section_heading">
        <span class="sec_subtitle text-white">
          <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#fff" />
          </svg> 
          {{ section.settings.section_subtitle }}
        </span>
        <h2 class="sec_typo text-white">
          <span class="fw-normal">{{ section.settings.section_title_prefix }}</span> <br>
          <span class="font-we-sb">Partner with <span class="theme-color-text">{{ section.settings.highlighted_text }}</span> Today</span>
        </h2>
        <p class="mb-0 p_font_color mb-4 mt-4">
          {{ section.settings.section_description }}
        </p>
      </div>
      <div class="rts-btn-main d-flex flex-wrap align-items-center gap-3">
        <div class="btn-wp">
          <a href="{{ section.settings.primary_button_link }}" class="btn btn-with-arrow white-bg-black yellow-btn">{{ section.settings.primary_button_text }}</a>
        </div>
        <div class="btn-wp">
          <a href="{{ settings.call_us_url }}" class="btn btn-with-border">
            <svg class="me-2" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.86952 11.473C9.70414 11.5143 9.52962 11.498 9.37471 11.4269C7.29136 10.4044 5.60542 8.72056 4.58033 6.63849C4.50441 6.48276 4.48474 6.30555 4.52466 6.13696C4.56459 5.96838 4.66164 5.81881 4.79934 5.71367L5.15037 5.4504C5.33668 5.31066 5.4879 5.12947 5.59205 4.92117C5.6962 4.71287 5.75042 4.48319 5.75042 4.2503V2.00012C5.75042 1.60226 5.59237 1.2207 5.31104 0.939375C5.02972 0.658048 4.64816 0.5 4.2503 0.5H2.00012C1.60226 0.5 1.2207 0.658048 0.939375 0.939375C0.658048 1.2207 0.5 1.60226 0.5 2.00012C0.5 5.58083 1.92243 9.01488 4.45437 11.5468C6.98632 14.0788 10.4204 15.5012 14.0011 15.5012C14.3989 15.5012 14.7805 15.3432 15.0618 15.0618C15.3432 14.7805 15.5012 14.3989 15.5012 14.0011V11.7509C15.5012 11.353 15.3432 10.9715 15.0618 10.6902C14.7805 10.4088 14.3989 10.2508 14.0011 10.2508H11.7509C11.518 10.2508 11.2883 10.305 11.08 10.4092C10.8717 10.5133 10.6905 10.6645 10.5508 10.8508L10.2845 11.1996C10.1813 11.3352 10.0349 11.4316 9.86952 11.473Z" stroke="#7F8081" stroke-linecap="round"/>
            </svg> {{ settings.call_us_text }}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ready to Start",
  "settings": [
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Ready to Start?"
    },
    {
      "type": "text",
      "id": "section_title_prefix",
      "label": "Section Title Prefix",
      "default": "Empower Your Growth:"
    },
    {
      "type": "text",
      "id": "highlighted_text",
      "label": "Highlighted Text",
      "default": "Cloud Downunder"
    },
    {
      "type": "text",
      "id": "section_title_suffix",
      "label": "Section Title Suffix",
      "default": "Partner with Cloud Downunder Today"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Join 500+ Australian businesses who trust Cloud Downunder to deliver technology that actually works."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Discuss your project"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary Button Link"
    }
  ],
  "presets": [
    {
      "name": "Ready to Start"
    }
  ]
}
{% endschema %}