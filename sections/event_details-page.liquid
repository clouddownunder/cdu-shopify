<!-- Event Details Hero Banner Start -->
{%- liquid
  assign main_speaker = section.blocks | where: 'type', 'speaker' | first
-%}
<section class="banner-sec mh-auto banner-height-auto mt-2 event-details-banner map-bg">
  <div class="banner-wrap">
    <div class="container">
      <div class="event-hero-card">
        <div class="event-hero-bg-pattern"></div>
        <div class="row align-items-center">
          <div class="col-lg-8 col-md-12">
            <div class="event-hero-left">
              {%- if section.settings.event_title != blank -%}
                <div class="event-breadcrumbs">
                  <a href="index.html">Home</a>
                  <span class="sep">/</span>
                  <span class="current">Events - {{ section.settings.event_title }}</span>
                </div>
              {%- endif -%}
              {%- if section.settings.event_date_display != blank -%}
                {% assign event_date = section.settings.event_date_display | date: '%s' %}
                {% assign current_date = 'now' | date: '%s' %}
                {% assign seconds_difference = event_date | minus: current_date %}
                {% assign days_to_go = seconds_difference | divided_by: 86400 %}
              {%- endif -%}
              {%- if days_to_go != blank or section.settings.category != blank -%}
                <div class="event-hero-tags">
                  {%- if days_to_go != blank -%}
                    <span class="event-badge-days">
                      {% if days_to_go > 0 %}
                        {{ days_to_go }}
                        {% if days_to_go == 1 %}day{% else %}days{% endif %} to go
                      {% elsif days_to_go == 0 %}
                        Today
                      {% endif -%}
                    </span>
                  {%- endif -%}
                  {%- if section.settings.category != blank -%}
                    <span class="event-badge-cat">{{ section.settings.category }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if section.settings.event_title != blank -%}
                <h1 class="event-hero-title">{{ section.settings.event_title }}</h1>
              {%- endif -%}
              {%- if section.settings.event_date_display != blank or section.settings.location != blank -%}
                <div class="event-hero-meta">
                  {%- if section.settings.event_date_display != blank -%}
                    <div class="event-hero-meta-item">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                        <line x1="16" x2="16" y1="2" y2="6"/>
                        <line x1="8" x2="8" y1="2" y2="6"/>
                        <line x1="3" x2="21" y1="10" y2="10"/>
                      </svg>
                      <span>{{ section.settings.event_date_display | date: '%a %-d %b %Y' }}</span>
                    </div>
                    <div class="event-hero-meta-item">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                      </svg>
                      <span>{{ section.settings.event_date_display | date: '%-I:%M%P' }}</span>
                    </div>
                  {%- endif -%}
                  {%- if section.settings.location != blank -%}
                    <div class="event-hero-meta-item">
                      <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                        <circle cx="12" cy="10" r="3"/>
                      </svg>
                      <span>{{ section.settings.location }}</span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if section.settings.register_url != blank -%}
                <div class="event-hero-btn">
                  <div class="btn-wp">
                    <a href="{{ section.settings.register_url }}" class="btn btn-with-arrow">{{ section.settings.register_button_text | default: 'Get tickets' }}</a>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
          {%- if main_speaker -%}
            <div class="col-lg-4 col-md-12">
              {%- for block in section.blocks -%}
                {%- if block.type == 'speaker' -%}
                  <div class="event-hero-speaker">
                    {%- if block.settings.image != blank -%}
                      <div class="event-speaker-avatar-wrap">
                        <img
                          src="{{ block.settings.image | image_url }}"
                          alt="{{ block.settings.name | escape }}"
                          class="event-speaker-avatar"
                        >
                      </div>
                    {%- endif -%}
                    {%- if block.settings.name != blank -%}
                      <h3 class="event-speaker-name">{{ block.settings.name }}</h3>
                    {%- endif -%}
                    <span class="event-speaker-role">{{ block.settings.hero_label | default: 'Speaker' }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
<!-- Event Details Hero Banner End -->

<!-- Event Details Main Content Section Start -->
<section class="event-details-sec">
  <div class="container">
    <div class="event-details-row">
      <!-- Left Sticky Info Card Column -->
      <div class="event-sidebar-col">
        <div class="event-sidebar-card">
          {%- if section.settings.event_date_display != blank -%}
            <div class="event-card-datetime">
              <div class="event-date-block">
                <span class="event-month">{{ section.settings.event_date_display | date: '%b' }}</span>
                <span class="event-day">{{ section.settings.event_date_display | date: '%-d' }}</span>
              </div>
              <div class="event-datetime-divider"></div>
              <div class="event-time-block">
                <h4 class="event-day-name">{{ section.settings.event_date_display | date: '%A' }}</h4>
                <span class="event-time-range">{{ section.settings.event_date_display | date: '%-I:%M%P' }}</span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.location != blank -%}
            <div class="event-card-location">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>{{ section.settings.location }}</span>
            </div>
          {%- endif -%}

          {%- if section.settings.register_url != blank -%}
            <div class="event-card-btn">
              <div class="btn-wp w-100">
                <a href="{{ section.settings.register_url }}" class="btn btn-with-arrow w-100">{{ section.settings.register_button_text | default: 'Get tickets' }}</a>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_icon_buttons -%}
            <div class="event-card-actions">
              <a
                class="event-action-link calendar-btn"
                style="cursor:pointer;"
                title="Add to calendar"
                aria-label="Add to calendar"
                data-event-title="{{ section.settings.event_title | escape }}"
                data-event-datetime="{{ section.settings.event_date_display }}"
                data-event-location="{{ section.settings.location | escape }}"
                data-event-url="{{ section.settings.register_url }}"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10.667 12.6702H14.6672M10.667 1.33594V4.00282M12.6671 10.67V14.6703M14.0005 8.40184V4.00282C14.0005 3.64917 13.86 3.31 13.61 3.05993C13.3599 2.80986 13.0208 2.66938 12.6671 2.66938H3.33339C2.97975 2.66938 2.6406 2.80986 2.39054 3.05993C2.14048 3.31 2 3.64917 2 4.00282V13.3369C2 13.6905 2.14048 14.0297 2.39054 14.2798C2.6406 14.5299 2.97975 14.6703 3.33339 14.6703H9.00029M2 6.6697H14.0005M5.33347 1.33594V4.00282" stroke="#7F8081" stroke-linecap="round"/>
                </svg>
                <span>Add to calendar</span>
              </a>
              <a
                class="event-action-link share-btn"
                style="cursor:pointer;"
                title="Share"
                aria-label="Share"
                data-share-title="{{ section.settings.event_title | escape }}"
                data-share-url="{{ section.settings.register_url }}"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="18" cy="5" r="3"/>
                  <circle cx="6" cy="12" r="3"/>
                  <circle cx="18" cy="19" r="3"/>
                  <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
                  <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
                </svg>
                <span>Share</span>
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Content Column -->
      <div class="event-content-col">
        {%- if section.settings.about_heading != blank or section.settings.about_lead != blank or section.settings.about_text != blank or section.settings.event_when != blank or section.settings.event_where != blank or section.settings.event_url != blank -%}
          <div class="blog-details-main">
            {%- if section.settings.about_heading != blank -%}
              <div class="event-sec-badge">
                <svg
                  class="event-badge-icon"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#0B0C0E"></path>
                </svg>
                <span>{{ section.settings.about_heading }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.about_lead != blank -%}
              <p class="event-intro-lead">{{ section.settings.about_lead }}</p>
            {%- endif -%}
            {%- if section.settings.about_text != blank -%}
              {{ section.settings.about_text }}
            {%- endif -%}
            {%- if section.settings.event_when != blank
              or section.settings.event_where != blank
              or section.settings.event_url != blank
            -%}
              <div class="event-content-divider"></div>

              <div class="event-details-meta-block">
                {%- if section.settings.event_when != blank -%}
                  <p class="mb-2">
                    <strong>When:</strong> {{ section.settings.event_when }}
                  </p>
                {%- endif -%}

                {%- if section.settings.event_where != blank -%}
                  <p class="mb-3">
                    <strong>Where:</strong> {{ section.settings.event_where }}
                  </p>
                {%- endif -%}

                {%- if section.settings.event_url != blank -%}
                  <p class="mb-0">
                    <a
                      href="{{ section.settings.event_url }}"
                      class="event-external-link"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      View Adam's session

                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                      >
                        <path
                          d="M14 8.66667V12.6667C14 13.0203 13.8595 13.3594 13.6095 13.6095C13.3594 13.8594 13.0203 14 12.6667 14H3.33333C2.97971 14 2.64057 13.8594 2.64057 13.6095C2.39052 13.3595 2 13.0203 2 12.6667V3.33333C2 2.97971 2.14048 2.64057 2.39052 2.39052C2.64057 2.14048 2.97971 2 3.33333 2H7.33333M14 2L8 8M14 6V2H10"
                          stroke="#0B0C0E"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}

            <div class="event-content-divider"></div>
          </div>
        {%- endif -%}

        <!-- Speaker Bio Section -->
        {%- assign speaker_blocks = section.blocks | where: 'type', 'speaker' -%}
        {%- if speaker_blocks.size > 0 -%}
          <div class="event-sec-badge mt-4">
            <svg
              class="event-badge-icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z" fill="#0B0C0E"></path>
            </svg>
            <span>{{ section.settings.speakers_heading | default: 'About the Speaker' }}</span>
          </div>
          {%- for block in speaker_blocks -%}
            <div class="speaker-profile-card">
              {%- if block.settings.linkedin_url != blank -%}
                <a href="{{ block.settings.linkedin_url }}" class="speaker-corner-btn" aria-label="View Speaker Profile" target="_blank" rel="noopener">
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.9165 11.0833L11.0832 2.91663M11.0832 2.91663H4.6665M11.0832 2.91663V9.33329" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              {%- endif -%}
              <div class="speaker-profile-header">
                {%- if block.settings.image != blank -%}
                  <div class="speaker-profile-avatar-wrap">
                    <img
                      src="{{ block.settings.image | image_url: width: 300 }}"
                      alt="{{ block.settings.name | escape }}"
                      class="speaker-profile-avatar m-0"
                    >
                  </div>
                {% endif %}
                {%- if block.settings.name != blank or block.settings.role != blank or block.settings.bio != blank -%}
                  <div class="speaker-profile-meta">
                    {%- if block.settings.name != blank -%}
                      <h3 class="speaker-profile-name">{{ block.settings.name }}</h3>
                    {%- endif -%}
                    {%- if block.settings.role != blank -%}
                      <span class="speaker-profile-role">{{ block.settings.role }}</span>
                    {%- endif -%}
                    {%- if block.settings.bio != blank -%}
                      <div class="speaker-profile-bio mt-3">
                        {{ block.settings.bio }}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {% endfor %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
<!-- Event Details Main Content Section End -->

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Calendar button functionality
    const calendarBtn = document.querySelector('.calendar-btn');
    if (calendarBtn) {
      calendarBtn.addEventListener('click', function () {
        const title = this.dataset.eventTitle;
        const datetimeStr = this.dataset.eventDatetime; // now expected as ISO 8601 with offset, e.g. 2026-09-16T01:40:00+10:00
        const location = this.dataset.eventLocation;
        const url = this.dataset.eventUrl;

        // Primary path: native parsing of ISO 8601 with explicit offset (reliable across all browsers).
        let dateObj = new Date(datetimeStr);

        // Fallback: legacy "Wed 16 Sep 2026, 1:40 am" style strings, in case the setting
        // hasn't been migrated to ISO format yet.
        if (isNaN(dateObj.getTime())) {
          const months = { jan:0, feb:1, mar:2, apr:3, may:4, jun:5, jul:6, aug:7, sep:8, oct:9, nov:10, dec:11 };
          const match = datetimeStr.match(
            /(\d{1,2})\s+([A-Za-z]{3,})\s+(\d{4})(?:,?\s+(\d{1,2}):(\d{2})\s*(am|pm)?)?/i
          );
          if (match) {
            const [, day, monthName, year, hour, minute, ampm] = match;
            let h = hour ? parseInt(hour, 10) : 0;
            const m = minute ? parseInt(minute, 10) : 0;
            if (ampm) {
              const isPM = ampm.toLowerCase() === 'pm';
              if (isPM && h !== 12) h += 12;
              if (!isPM && h === 12) h = 0;
            }
            const monthIndex = months[monthName.slice(0, 3).toLowerCase()];
            dateObj = new Date(parseInt(year, 10), monthIndex, parseInt(day, 10), h, m);
          }
        }

        if (isNaN(dateObj.getTime())) {
          console.error('Invalid date format:', datetimeStr);
          alert('Could not read the event date/time.');
          return;
        }

        // Format dates for ICS (UTC)
        const formatDate = (date) =>
          date.toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z';

        const startTime = formatDate(dateObj);
        const endTime = formatDate(new Date(dateObj.getTime() + 3 * 60 * 60 * 1000)); // +3 hours

        const uid = title.toLowerCase().replace(/[^a-z0-9]/g, '-') + '-' + Date.now() + '@clouddownunder.myshopify.com';

        const escapeIcsText = (str) =>
          (str || '')
            .replace(/\\/g, '\\\\')
            .replace(/;/g, '\\;')
            .replace(/,/g, '\\,')
            .replace(/\n/g, '\\n');

        // RFC 5545: lines must be folded at 75 octets. Continuation lines start with a single space.
        const foldLine = (line) => {
          if (line.length <= 75) return line;
          let result = '';
          let pos = 0;
          let first = true;
          while (pos < line.length) {
            const chunkLen = first ? 75 : 74; // subsequent lines lose 1 char to the leading space
            result += (first ? '' : '\r\n ') + line.slice(pos, pos + chunkLen);
            pos += chunkLen;
            first = false;
          }
          return result;
        };

        // Build as an array of lines - no leading whitespace, each folded if needed
        const rawLines = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//CDU//Events//EN',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          `UID:${uid}`,
          `DTSTAMP:${formatDate(new Date())}`,
          `DTSTART:${startTime}`,
          `DTEND:${endTime}`,
          `SUMMARY:${escapeIcsText(title)}`,
          `LOCATION:${escapeIcsText(location)}`,
          `URL:${url}`,
          'END:VEVENT',
          'END:VCALENDAR'
        ];

        const icsContent = rawLines.map(foldLine).join('\r\n') + '\r\n';

        // Create and download the ICS file
        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `${title.replace(/[^a-z0-9]/gi, '_')}.ics`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);
      });
    }

    // Share button functionality
    const shareBtn = document.querySelector('.share-btn');
    if (shareBtn) {
      shareBtn.addEventListener('click', async function () {
        const shareTitle = this.dataset.shareTitle;
        const shareUrl = this.dataset.shareUrl;

        if (navigator.share) {
          try {
            await navigator.share({ title: shareTitle, url: shareUrl });
          } catch (err) {
            console.log('Share canceled or failed:', err);
          }
        } else if (navigator.clipboard) {
          try {
            await navigator.clipboard.writeText(shareUrl);
            alert('Link copied to clipboard!');
          } catch (err) {
            console.error('Failed to copy:', err);
            alert('Failed to copy link');
          }
        } else {
          const textArea = document.createElement('textarea');
          textArea.value = shareUrl;
          document.body.appendChild(textArea);
          textArea.select();
          document.execCommand('copy');
          document.body.removeChild(textArea);
          alert('Link copied to clipboard!');
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Event Detail",
  "tag": "section",
  "class": "event-detail-section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "category",
      "label": "Category",
      "default": "User Groups"
    },
    {
      "type": "text",
      "id": "event_title",
      "label": "Event title",
      "default": "September User Group - Getting Found in the Age of AI"
    },
    {
      "type": "text",
      "id": "event_date_display",
      "label": "Date and Time",
      "info": "Use ISO 8601 format with your shop's timezone offset, e.g. 2026-09-16T01:40:00+10:00 for 1:40am Melbourne time (AEST, UTC+10). Find your offset in Shopify Admin → Settings → General → Store defaults. Leaving out the offset causes Shopify's date filter to misread the day (it assumes UTC, then converts to your shop's timezone, which can shift the displayed date by a day).",
      "default": "2026-09-16T01:40:00+10:00"
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Melbourne"
    },
    {
      "type": "text",
      "id": "register_url",
      "label": "Register link"
    },
    {
      "type": "text",
      "id": "register_button_text",
      "label": "Register button text",
      "default": "Register now"
    },
    {
      "type": "header",
      "content": "About the event"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About heading",
      "default": "About the Event"
    },
    {
      "type": "text",
      "id": "about_lead",
      "label": "About Lead",
      "default": "Adam Cogan is speaking at NDC Oslo 2026."
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>How AI is rewriting the way businesses get discovered online. From traditional SEO to AI-powered search, and what it means for your brand's visibility.</p>"
    },
    {
      "type": "text",
      "id": "event_when",
      "label": "Event When",
      "default": "Wednesday 16 September 2026, 13:40 &ndash; 14:40 (UTC+02)"
    },
    {
      "type": "text",
      "id": "event_where",
      "label": "Event Where",
      "default": "Room 6, Oslo Spektrum, Sonja Henies plass 2, 0185 Oslo"
    },
    {
      "type": "text",
      "id": "event_url",
      "label": "Event Url",
      "default": "#"
    },
    {
      "type": "header",
      "content": "Speakers"
    },
    {
      "type": "text",
      "id": "speakers_heading",
      "label": "Speakers heading",
      "default": "About the Speaker"
    },
    {
      "type": "checkbox",
      "id": "show_icon_buttons",
      "label": "Show calendar / share buttons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "speaker",
      "name": "Speaker",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Jack Bear"
        },
        {
          "type": "text",
          "id": "hero_label",
