<section class="up-events-sec">
  <div class="container">
    <div class="row align-items-lg-end">
      <div class="col-lg-8">
        <div class="section_heading">
          <span class="sec_subtitle mb-0 black_text">
            <svg
              class="sec_sub_icon"
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
              d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z"
              fill="#000" />
            </svg>
            EVENTS
          </span>
          <h2 class="sec_typo mb-0 mt-1">{{  section.settings.heading }}</h2>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="section_heading">
          <p class="mb-0 p_font_color font-300 mt-lg-4 mt-3 method-disc">
            {{ section.settings.description }}
          </p>
        </div>
      </div>
    </div>
    <div class="up-events-main">
      {% assign event_array = shop.metaobjects.event.values %}
      {% assign sorted_events = event_array | sort: 'date_and_time.value' | reverse %}
      {% assign upcoming_count = 0 %}

      {% for event in sorted_events %}
        {% assign event_timestamp = event.date_and_time.value | date: '%s' | times: 1 %}
        {% assign current_timestamp = 'now' | date: '%s' | times: 1 %}
        {% assign current_timestamp_aest = current_timestamp | plus: 36000 %}
        {% assign event_date = event.date_and_time.value | date: "%s" %}
        {% assign current_date = "now" | date: "%s" %}
        {% assign seconds_difference = event_date | minus: current_date %}
        {% assign days_to_go = seconds_difference | divided_by: 86400 %}

        {% if event_timestamp > current_timestamp_aest %}
          {% assign upcoming_count = upcoming_count | plus: 1 %}

          {% if upcoming_count == 1 %}
            <div class="up-event-featured-card">
              <div class="up-event-featured-bg">
                <img
                  src="{{ section.settings.cover_image | image_url }}"
                  alt="{{ event.title.value }}"
                  class="up-event-hero-img"
                >
                <div class="up-event-featured-overlay"></div>
              </div>
              <div class="up-event-featured-content">
                <div class="up-event-featured-top">
                  <span class="up-event-badge-highlight">UPCOMING EVENT</span>
                  <span class="up-event-badge-pill">
                    {% if days_to_go > 0 %}
                    {{ days_to_go }} {% if days_to_go == 1 %}day{% else %}days{% endif %} to go
                    {% elsif days_to_go == 0 %}
                      Today
                    {% endif %}
                  </span>
                </div>
                <h3 class="up-event-featured-title">
                  {{ event.title.value }}
                </h3>
                <div class="up-event-meta-list">
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>{{ event.location.value | append: '' | split: ',' | last | strip }}</span>
                  </div>
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                      <line x1="16" x2="16" y1="2" y2="6"/>
                      <line x1="8" x2="8" y1="2" y2="6"/>
                      <line x1="3" x2="21" y1="10" y2="10"/>
                    </svg>
                    <span>{{ event.date_and_time.value | date: "%a %-d %b" }}</span>
                  </div>
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>{{ event.date_and_time.value | date: "%-I:%M%P" }} AEST</span>
                  </div>
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span>{{ event.person_name.value }}</span>
                  </div>
                </div>
                <div class="up-event-featured-bottom">
                  <div
                    class="up-event-countdown mb-5 countdown-pill"
                    data-countdown="{{ event.date_and_time.value | date: '%Y-%m-%dT%H:%M:%S' }}"
                  >
                    <div class="countdown-unit">
                      <span class="countdown-num value days">00</span>
                      <span class="countdown-label">DAYS</span>
                    </div>
                    <div class="countdown-divider"></div>
                    <div class="countdown-unit">
                      <span class="countdown-num value hours">00</span>
                      <span class="countdown-label">HOURS</span>
                    </div>
                    <div class="countdown-divider"></div>
                    <div class="countdown-unit">
                      <span class="countdown-num value mins">00</span>
                      <span class="countdown-label">MIN</span>
                    </div>
                    <div class="countdown-divider"></div>
                    <div class="countdown-unit">
                      <span class="countdown-num value secs">00</span>
                      <span class="countdown-label">SECS</span>
                    </div>
                  </div>
                  <div class="btn-wp">
                    <a href="{{ event.system.url }}" class="btn btn-with-arrow white-btn">Register Now</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="up-events-list">
          {% else %}
            <div class="up-event-card">
              <div class="up-event-card-img">
                <a href="#" class="d-inline-block w-100 h-100">
                  <img
                    src="{{ event.logo.value | image_url }}"
                    alt="{{ event.title.value }}"
                  >
                </a>
              </div>
              <div class="up-event-card-info">
                <h4 class="up-event-card-title">
                  <a href="{{ event.system.url }}">{{ event.title.value }}</a>
                </h4>
                <div class="up-event-card-meta">
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    <span>{{ event.person_name.value }}</span>
                  </div>
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                      <circle cx="12" cy="10" r="3"/>
                    </svg>
                    <span>{{ event.location.value | append: '' | split: ',' | last | strip }}</span>
                  </div>
                  <div class="up-event-meta-item">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    <span>{{ event.date_and_time.value | date: "%-I:%M%P" }} AEST</span>
                  </div>
                </div>
                <div class="up-event-card-about">
                  <span class="about-title">About the Event</span>
                  <p class="about-desc">{{ event.about_description_lead.value }}</p>
                </div>
              </div>
              <div class="up-event-card-action ">
                <div class="up-event-card-date-wrap  text-lg-center">
                  <span class="up-event-card-date">{{ event.date_and_time.value | date: "%-d %B" }}</span>
                  <span class="up-event-card-days">
                    {% if days_to_go > 0 %}
                      {{ days_to_go }} {% if days_to_go == 1 %}day{% else %}days{% endif %} to go
                    {% elsif days_to_go == 0 %}
                      Today
                    {% endif %}
                  </span>
                </div>
                <div class="btn-wp ">
                  <a href="{{ event.system.url }}" class="btn btn-with-arrow">Register Now</a>
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if upcoming_count > 1 %}
        </div><!-- .up-events-list -->
      {% endif %}
    </div>
  </div>
</section>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.countdown-pill').forEach(function (countdown) {

    const countdownValue = countdown.getAttribute('data-countdown');

    if (!countdownValue) return;

    const targetDate = new Date(countdownValue).getTime();

    if (isNaN(targetDate)) {
      console.error('Invalid countdown date:', countdownValue);
      return;
    }

    function updateCountdown() {
      const now = new Date().getTime();
      const difference = targetDate - now;

      if (difference <= 0) {
        countdown.querySelector('.days').textContent = '00';
        countdown.querySelector('.hours').textContent = '00';
        countdown.querySelector('.mins').textContent = '00';
        countdown.querySelector('.secs').textContent = '00';
        return;
      }

      const days = Math.floor(
        difference / (1000 * 60 * 60 * 24)
      );

      const hours = Math.floor(
        (difference / (1000 * 60 * 60)) % 24
      );

      const minutes = Math.floor(
        (difference / (1000 * 60)) % 60
      );

      const seconds = Math.floor(
        (difference / 1000) % 60
      );

      countdown.querySelector('.days').textContent =
        String(days).padStart(2, '0');

      countdown.querySelector('.hours').textContent =
        String(hours).padStart(2, '0');

      countdown.querySelector('.mins').textContent =
        String(minutes).padStart(2, '0');

      countdown.querySelector('.secs').textContent =
        String(seconds).padStart(2, '0');
    }

    updateCountdown();

    setInterval(updateCountdown, 1000);
  });
});
</script>
{% schema %}
{
  "name": "Upcoming Event",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default":"Upcoming Events"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default":"Stay connected with the latest technology events, conferences, and industry sessions."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "See More Events"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Url"
    }
  ],
  "presets": [
    {
      "name": "Upcoming Event"
    }
  ]
}
{% endschema %}
