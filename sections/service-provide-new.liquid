<section
  class="{{ section.settings['section-class'] }} service-provide-sec sec-padding"
  id="{{ section.settings['section-id'] }}"
>
  <div class="container">

    <!-- TOP CONTENT -->
    <div class="row gx-xl-5 gx-3 gy-3">

      <!-- LEFT CONTENT -->
      <div class="col-xl-6 col-lg-5">
        <div class="wrap-service-head d-flex flex-column h-100">

          <div class="section_heading text-start">

            {% if section.settings.subtitle != blank %}
              <span class="sec_subtitle mb-0 theme_black">

                <svg
                  class="sec_sub_icon"
                  width="20"
                  height="20"
                  viewBox="0 0 20 20"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z"
                    fill="#0B0C0E"
                  />
                </svg>

                {{ section.settings.subtitle }}
              </span>
            {% endif %}

            {% if section.settings.heading != blank %}
              <h2 class="sec_typo mb-0 mt-1">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

          </div>

          {% if section.settings.button-text != blank %}
            <div class="btn-wp d-none d-lg-block">
              <a
                href="{{ section.settings['button-url'] }}"
                class="btn btn-with-arrow me-3 mb-0"
              >
                {{ section.settings['button-text'] }}
              </a>
            </div>
          {% endif %}

        </div>
      </div>


      <!-- RIGHT CONTENT -->
      <div class="col-xl-6 col-lg-7">
        <div>

          {% if section.settings.description != blank %}
            <p class="mb-0 service-disc p_font_color">
              {{ section.settings.description }}
            </p>
          {% endif %}


          <!-- SERVICES METAOBJECT -->
          {% assign services = section.settings['metaobject-list'] %}

          {% if services != blank %}
            <div class="provide-service-label tech-stack">

              {% for service in services %}

                {% if service.system.url != blank %}
                  <a
                    href="{{ service.system.url }}"
                    class="sr-re-label"
                  >
                    {% if service.text != blank %}
                      {{ service.text.value }}
                    {% else %}
                      {{ service }}
                    {% endif %}
                  </a>
                {% else %}
                  <span class="sr-re-label">
                    {% if service.text != blank %}
                      {{ service.text.value }}
                    {% else %}
                      {{ service }}
                    {% endif %}
                  </span>
                {% endif %}

              {% endfor %}

            </div>
          {% endif %}


          <!-- MOBILE BUTTON -->
          {% if section.settings.button-text != blank %}
            <div class="btn-wp d-lg-none d-block mt-4">
              <a
                href="{{ section.settings['button-url'] }}"
                class="btn btn-with-arrow me-3 mb-0"
              >
                {{ section.settings['button-text'] }}
              </a>
            </div>
          {% endif %}

        </div>
      </div>

    </div>


    <!-- SPECIALIST / CTA SECTION -->
    <div class="explore-service-wrap rts-cdu-sec">

      <div class="rts-cdu-main">

        <div class="row">

          <!-- LEFT CTA CONTENT -->
          <div class="col-xl-8 col-lg-7">

            <div class="salesforce-service-wrap">

              <div class="section_heading">

                {% if section.settings.bottom_heading != blank %}
                  <h2 class="sec_typo text-white">
                    {{ section.settings.bottom_heading }}
                  </h2>
                {% endif %}

                {% if section.settings.bottom_description != blank %}
                  <p class="mb-0 p_font_color mb-4 mt-2 font-300">
                    {{ section.settings.bottom_description }}
                  </p>
                {% endif %}

              </div>


              <!-- CTA BUTTONS -->
              <div class="rts-btn-main d-flex flex-wrap align-items-center gap-3">

                {% if section.settings.primary_button_text != blank %}
                  <div class="btn-wp">
                    <a
                      href="{{ section.settings.primary_button_url }}"
                      class="btn btn-with-arrow white-bg-black yellow-btn"
                    >
                      {{ section.settings.primary_button_text }}
                    </a>
                  </div>
                {% endif %}


                {% if section.settings.phone_button_text != blank %}
                  <div class="btn-wp">

                    <a
                      href="tel:{{ section.settings.phone_number | remove: ' ' }}"
                      class="btn btn-with-border"
                    >

                      <svg
                        class="me-2"
                        width="16"
                        height="16"
                        viewBox="0 0 16 16"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M9.86952 11.473C9.70414 11.5143 9.52962 11.498 9.37471 11.4269C7.29136 10.4044 5.60542 8.72056 4.58033 6.63849C4.50441 6.48276 4.48474 6.30555 4.52466 6.13696C4.56459 5.96838 4.66164 5.81881 4.79934 5.71367L5.15037 5.4504C5.33668 5.31066 5.4879 5.12947 5.59205 4.92117C5.6962 4.71287 5.75042 4.48319 5.75042 4.2503V2.00012C5.75042 1.60226 5.59237 1.2207 5.31104 0.939375C5.02972 0.658048 4.64816 0.5 4.2503 0.5H2.00012C1.60226 0.5 1.2207 0.658048 0.939375 0.939375C0.658048 1.2207 0.5 1.60226 0.5 2.00012C0.5 5.58083 1.92243 9.01488 4.45437 11.5468C6.98632 14.0788 10.4204 15.5012 14.0011 15.5012C14.3989 15.5012 14.7805 15.3432 15.0618 15.0618C15.3432 14.7805 15.5012 14.3989 15.5012 14.0011V11.7509C15.5011 11.353 15.3432 10.9715 15.0618 10.6902C14.7805 10.4088 14.3989 10.2508 14.0011 10.2508H11.7509C11.518 10.2508 11.2883 10.305 11.08 10.4092C10.8717 10.5133 10.6905 10.6645 10.5508 10.8508L10.2845 11.1996C10.1813 11.3352 10.0349 11.4316 9.86952 11.473Z"
                          stroke="#DDDDDD"
                          stroke-linecap="round"
                        />
                      </svg>

                      {{ section.settings.phone_button_text }}

                    </a>

                  </div>
                {% endif %}

              </div>

            </div>

          </div>


          <!-- SPECIALISTS -->
          <div class="col-xl-4 col-lg-5">

            {% if section.blocks.size > 0 %}

              <div class="rts-cdu-specialists">

                {% for block in section.blocks %}

                  {% if block.type == 'specialist' %}

                    <div
                      class="rts-cdu-specialist text-center"
                      {{ block.shopify_attributes }}
                    >

                      {% if block.settings.image != blank %}
                        <div class="avatar-wrap">

                          {{
                            block.settings.image
                            | image_url: width: 300
                            | image_tag:
                              loading: 'lazy',
                              widths: '100,150,200,300',
                              alt: block.settings.name
                          }}

                        </div>
                      {% endif %}


                      {% if block.settings.name != blank %}
                        <div class="specialist-name">
                          {{ block.settings.name }}
                        </div>
                      {% endif %}


                      {% if block.settings.role != blank %}
                        <div class="specialist-role">
                          {{ block.settings.role }}
                        </div>
                      {% endif %}

                    </div>

                  {% endif %}

                {% endfor %}

              </div>

            {% endif %}

          </div>

        </div>


        <!-- STATS -->
        {% assign stats_count = 0 %}

        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            {% assign stats_count = stats_count | plus: 1 %}
          {% endif %}
        {% endfor %}


        {% if stats_count > 0 %}

          <div
            class="d-grid stats position-relative"
            style="--stats-count: {{ stats_count }};"
          >

            {% for block in section.blocks %}

              {% if block.type == 'stat' %}

                <div
                  class="stats-box"
                  {{ block.shopify_attributes }}
                >

                  {% if block.settings.value != blank %}
                    <h3>
                      {{ block.settings.value }}
                    </h3>
                  {% endif %}

                  {% if block.settings.label != blank %}
                    <span class="p_font_color">
                      {{ block.settings.label }}
                    </span>
                  {% endif %}

                </div>

              {% endif %}

            {% endfor %}

          </div>

        {% endif %}

      </div>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "Service provide New",
  "tag": "section",
  "class": "service-provide-section",
  "settings": [
    {
      "type": "text",
      "id": "section-id",
      "label": "Section ID",
      "default": "salesforce"
    },
    {
      "type": "text",
      "id": "section-class",
      "label": "Section Class",
      "default": "salesforce-sec"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Microsoft"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Microsoft Solutions That Drive Growth & Customer Success."
    },
    {
      "type": "text",
      "id": "button-text",
      "label": "Button Text",
      "default": "View Details"
    },
    {
      "type": "url",
      "id": "button-url",
      "label": "Button URL"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "We help Australian organisations unlock the full potential of the Microsoft ecosystem—from Microsoft 365 and Dynamics 365 to Power Platform and Azure—driving productivity, automation and seamless collaboration across your business."
    },
    {
      "type": "metaobject_list",
      "id": "metaobject-list",
      "label": "Services",
      "metaobject_type": "service",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Bottom CTA"
    },
    {
      "type": "textarea",
      "id": "bottom_heading",
      "label": "Bottom Heading",
      "default": "Meet Your Azure Specialists"
    },
    {
      "type": "textarea",
      "id": "bottom_description",
      "label": "Bottom Description",
      "default": "Certified Microsoft engineers delivering enterprise cloud solutions across Australia."
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Primary Button Text",
      "default": "Discuss your project"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "phone_button_text",
      "label": "Phone Button Text",
      "default": "Call 1300 699 571"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "1300 699 571"
    }
  ],
  "blocks": [
    {
      "type": "specialist",
      "name": "Specialist",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Profile Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Gokul M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Business Consultant"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "60%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Faster"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service provide New",
      "blocks": [
        {
          "type": "specialist",
          "settings": {
            "name": "Gokul M.",
            "role": "Business Consultant"
          }
        },
        {
          "type": "specialist",
          "settings": {
            "name": "Rom O.",
            "role": "Sr. Business Consultant"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "60%",
            "label": "Faster"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "130+",
            "label": "Projects"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "99.9%",
            "label": "Uptime"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "24/7",
            "label": "Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}