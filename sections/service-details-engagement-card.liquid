{% if section.blocks.size > 0 %}
<section class="engagement-sec">
    <div class="container">
        <div class="engagement-wrap">
            <div class="section_heading text-center">
                <span class="sec_subtitle text-black mb-0">
                            <svg class="sec_sub_icon" width="20" height="20" viewBox="0 0 20 20" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path
                                    d="M0.3125 10L8.125 11.875L10 19.6875L11.875 11.875L19.6875 10L11.875 8.125L10 0.3125L8.125 8.125L0.3125 10Z"
                                    fill="#000" />
                            </svg>
                            {{ section.settings.subtitle }}
                        </span>
                <h2 class="sec_typo mb-0 mt-1">
                    {{ section.settings.heading }}
                </h2>
            </div>

            <div class="engagement-cards">
                {% for block in section.blocks %}
                    <div class="engagement-card{% if forloop.index == 2 %} engagement-card--featured{% endif %}">
                        <div class="engagement-card__head">
                            <h3 class="engagement-card__title">{{ block.settings.title }}</h3>
                            <span class="{% if forloop.index == 2 %} engagement-card__badge{% else %}engagement-card__meta{% endif %}">{{ block.settings.badge }}</span>
                        </div>

                        <p class="engagement-card__desc">{{ block.settings.description }}</p>

                        <ul class="engagement-card__list">
                            {{ block.settings.list }}
                        </ul>

                        <a href="{{ block.settings.button_url }}"
                        class="engagement-card__btn {% if forloop.index == 2 %}engagement-card__btn--solid{% else %}engagement-card__btn--dark{% endif %}">
                            {{ block.settings.button_text }}
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
{% endif %}
{% schema %}
{
  "name": "Service Engagement Card",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default":"Platforms"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clouds & platforms CDU is in demand for"
    }
  ],
  "blocks": [
    {
        "type": "list_item",
        "name": "List Item",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title",
            },
            {
                "type": "text",
                "id": "description",
                "label": "Description",
            },
            {
                "type": "text",
                "id": "badge",
                "label": "Badge",
            },
            {
                "type": "richtext",
                "id": "list",
                "label": "List",
            },
            {
                "type": "text",
                "id": "button_text",
                "label": "Button Text"
            },
            {
                "type": "url",
                "id": "button_url",
                "label": "Button Url"
            }
        ]
    }
  ],
  "presets": [
    {
      "name": "Service Detail Engagement Card"
    }
  ]
}
{% endschema %}