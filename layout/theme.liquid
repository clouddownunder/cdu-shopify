  <body class="page-wrapper" data-template="{{ page.title }}">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TF2LDFXL"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
    {% sections 'header-group' %}

    <main
    id="MainContent"
    class="content-for-layout focus-none{% if template.name == 'page' and template.suffix == 'service' %} service-page-wrap{% elsif request.path contains '/service/' %} service-detail-page-wrap{% endif %}"
    role="main"
    tabindex="-1"
    data-template="{{ template.name }}"
  >
    {{ content_for_layout }}
  </main>

    {% sections 'footer-group' %}
    {{ 'jquery.min.js' | asset_url | script_tag }}
    {{ 'gsap.min.js' | asset_url | script_tag }}
    {{ 'ScrollTrigger.min.js' | asset_url | script_tag }}
    {{ 'ScrollToPlugin.min.js' | asset_url | script_tag }}
    {{ 'bootstrap.min.js' | asset_url | script_tag }}
    {{ 'css3-animate-it.js' | asset_url | script_tag }}
    {{ 'slick.min.js' | asset_url | script_tag }}
    {{ 'fancybox.js' | asset_url | script_tag }}
    {{ 'swiper-bundle.min.js' | asset_url | script_tag }}
    {{ 'custom.js' | asset_url | script_tag }}

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const path = window.location.pathname;

        if (path.startsWith('/pages/')) {
          const newPath = path.replace(/^\/pages/, '');

          window.history.replaceState(
            {},
            document.title,
            newPath + window.location.search + window.location.hash
          );
        }
      });
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('a[href*="/pages/"]').forEach(function (link) {
          const url = new URL(link.href);

          if (url.pathname.startsWith('/pages/')) {
            url.pathname = url.pathname.replace(/^\/pages/, '');
            link.href = url.pathname + url.search + url.hash;
          }
        });
      });
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.age-display').forEach(function (element) {
          const experienceDate = new Date(element.dataset.experiencedate + 'T00:00:00');
          const today = new Date();
          let age = today.getFullYear() - experienceDate.getFullYear();
          const experiencedayThisYear = new Date(
            today.getFullYear(),
            experienceDate.getMonth(),
            experienceDate.getDate()
          );
          if (today < experiencedayThisYear) {
            age--;
          }
          element.textContent = age + '+';
        });
      });
    </script> 
    {% if request.path == '/collections' or request.path == '/products' %}
      <script>
        window.location.replace('/404');
      </script>
    {% endif %}
  </body>
</html>