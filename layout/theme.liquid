    <link rel="preload"
          as="image"
          href="https://clouddownunder.myshopify.com/cdn/shop/files/header-right-05.webp?v=1787545712">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-B902SR5NXX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-B902SR5NXX');
