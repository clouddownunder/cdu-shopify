<style>
  /* Hide the password page while automatic login is running */
  body {
    visibility: hidden !important;
  }

  #auto-password-loader {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    visibility: visible;
    font-family: Arial, sans-serif;
  }

  .auto-loader-content {
    text-align: center;
  }

  .auto-loader-spinner {
    width: 40px;
    height: 40px;
    margin: 0 auto 15px;
    border: 4px solid #eee;
    border-top-color: #008060;
    border-radius: 50%;
    animation: autoSpin 0.8s linear infinite;
  }

  .auto-loader-text {
    color: #333;
    font-size: 15px;
  }

  @keyframes autoSpin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<div id="auto-password-loader">
  <div class="auto-loader-content">
    <div class="auto-loader-spinner"></div>
    <div class="auto-loader-text">Loading store...</div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const PASSWORD = 'iaheuy';

  const passwordInput = document.querySelector(
    'input[name="password"], input#password'
  );

  if (!passwordInput) {
    return;
  }

  // Set password
  passwordInput.value = PASSWORD;

  // Trigger input/change events
  passwordInput.dispatchEvent(
    new Event('input', { bubbles: true })
  );

  passwordInput.dispatchEvent(
    new Event('change', { bubbles: true })
  );

  // Find password form
  const form = passwordInput.closest('form');

  if (form) {
    setTimeout(function () {
      form.submit();
    }, 300);
  }

});
</script>